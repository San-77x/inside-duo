# Cloudflare Web Analytics beacon token. Public — it is visible in the page source — so
# this is not a secret. Without it no analytics script is served at all.
# Get it from: Cloudflare dashboard > Analytics & Logs > Web Analytics > Add a site
NEXT_PUBLIC_CF_BEACON_TOKEN=

# Absolute URL this instance is served from; used to resolve og:image. Defaults to the
# canonical deployment, so forks should set their own here.
NEXT_PUBLIC_SITE_URL=
